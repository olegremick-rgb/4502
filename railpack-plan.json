
{
  "schema": "1.0",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install",
    "startCommand": "node server.js",
    "watchPaths": [
      "server.js",
      "index.html",
      "admin.html",
      "admin-login.html",
      "database.json",
      "uploads/"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "port": 3000
  },
  "env": {
    "SESSION_SECRET": {
      "generator": "secret",
      "description": "Секретний ключ для сесій"
    },
    "PORT": {
      "value": "3000",
      "description": "Порт для запуску сервера"
    },
    "NODE_ENV": {
      "value": "production",
      "description": "Середовище виконання"
    }
  },
  "volumes": [
    {
      "mountPath": "/app/uploads",
      "description": "Папка для завантажених файлів (фото, відео)"
    },
    {
      "mountPath": "/app/database.json",
      "description": "Файл бази даних"
    }
  ]
}
